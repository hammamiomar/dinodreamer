{
  "name": "dinodreamer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build:engine": "wasm-pack build --target web --release",
    "build:harness": "wasm-pack build --target web --release --out-dir pkg-harness --features harness && vite build --config vite.harness.config.ts",
    "benchmark:browser": "node benchmarks/browser.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
