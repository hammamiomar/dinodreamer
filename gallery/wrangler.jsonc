{
  // The public DinoDreamer app: app/dist as static assets, the gallery API and the owner page.
  // API, owner and public page routes run the Worker first. Public pages receive the same preview
  // media (src/link-preview.ts). The shared media uses the public library CDN, including byte-range support.
  // The Worker answers a missing /assets/* file with 404
  // instead of that index.html (src/worker.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinodreamer-public",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "ca9d38a784a1dbc033775ecfd6551682",
  // The Worker's own workers.dev address is off: its name is the account's subdomain, which Cloudflare takes
  // from the account's email. Pull request previews stay on workers.dev, behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": true,
  // Production.
  "routes": [{ "pattern": "dinodreamer.computervision.vision", "custom_domain": true }],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*", "/assets/*", "/admin", "/admin/*", "/", "/basis/*", "/index", "/index/*",
      "/explore", "/explore/*", "/block", "/block/*",
      "/playground", "/playground/*", "/grow", "/grow/*",
      "/automata", "/automata/*", "/train", "/train/*", "/picture", "/picture/*",
      "/how", "/how/*", "/create", "/create/*", "/canvas", "/canvas/",
      "/gallery", "/gallery/", "/saved", "/saved/"
    ]
  },
  // Bucket names must match src/storage.ts (test/gallery.test.ts checks this).
  "r2_buckets": [
    { "binding": "SUBMISSIONS", "bucket_name": "dinodreamer-submissions" },
    { "binding": "LIBRARY", "bucket_name": "dinodreamer-library" }
  ],
  // At most 3 submissions per client IP per minute.
  "ratelimits": [{ "name": "SUBMISSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Cloudflare Images makes an approved entry's thumbnail on the owner page (src/thumbnail.ts).
  "images": { "binding": "IMAGES" },
  "vars": {
    // The library CDN, as app/.env names it (a test checks): the owner page's purge step.
    "ASSET_BASE_URL": "https://library.computervision.vision",
    // Cloudflare Access in front of /admin (src/access.ts, README: Owner page). Not secrets: the
    // audience tag is inside every token. Without both, every /admin request is refused.
    "ACCESS_TEAM_DOMAIN": "https://morning-boat-6fad.cloudflareaccess.com",
    // The Access application "DinoDreamer owner page" (dinodreamer.computervision.vision/admin and /admin/*).
    "ACCESS_AUD": "4423c20889520528cfa8a4d14e35a26d650980d3282eda051cb06da33e62ffa2"
  }
}
