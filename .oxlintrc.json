{
  "$schema": "./ci/node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "jsdoc", "node", "promise"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "options": { "typeAware": true },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.wrangler/**",
    "engine/pkg*/**",
    "engine/target/**",
    "engine/vendor/**",
    "engine/dist-harness/**",
    "local/**"
  ],
  "env": { "browser": true, "node": true, "worker": true, "es2024": true },
  "rules": {
    // Explicit rules and options enforced alongside correctness, suspicious, and perf.
    "eslint/array-callback-return": "error",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["NumberInput"] }],
    "react/jsx-filename-extension": ["error", { "extensions": [".jsx", ".tsx"] }],
    "typescript/no-invalid-void-type": ["error", { "allowInGenericTypeArguments": true }],
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],

    // JavaScript control flow, expressions and standard APIs.
    "eslint/accessor-pairs": "error", "eslint/arrow-body-style": "error", "eslint/default-case-last": "error",
    "eslint/default-param-last": "error", "eslint/func-name-matching": "error",
    "eslint/grouped-accessor-pairs": "error", "eslint/guard-for-in": "error", "eslint/id-denylist": "error",
    "eslint/id-match": "error", "eslint/logical-assignment-operators": "error",
    "eslint/max-nested-callbacks": "error", "eslint/no-alert": "error", "eslint/no-array-constructor": "error",
    "eslint/no-case-declarations": "error", "eslint/no-div-regex": "error", "eslint/no-else-return": "error",
    "eslint/no-empty": "error", "eslint/no-extra-label": "error", "eslint/no-fallthrough": "error",
    "eslint/no-implicit-globals": "error", "eslint/no-inner-declarations": "error",
    "eslint/no-label-var": "error", "eslint/no-labels": "error", "eslint/no-lone-blocks": "error",
    "eslint/no-lonely-if": "error", "eslint/no-multi-str": "error", "eslint/no-new-func": "error",
    "eslint/no-new-wrappers": "error", "eslint/no-object-constructor": "error", "eslint/no-proto": "error",
    "eslint/no-prototype-builtins": "error", "eslint/no-redeclare": "error", "eslint/no-regex-spaces": "error",
    "eslint/no-restricted-exports": "error", "eslint/no-restricted-globals": "error",
    "eslint/no-restricted-imports": "error", "eslint/no-restricted-properties": "error",
    "eslint/no-return-assign": "error", "eslint/no-script-url": "error", "eslint/no-self-compare": "error",
    "eslint/no-throw-literal": "error", "eslint/no-undef": "error",
    "eslint/no-unreachable-loop": "error",
    "eslint/no-useless-assignment": "error", "eslint/no-useless-computed-key": "error",
    "eslint/no-useless-return": "error", "eslint/no-warning-comments": "error",
    "eslint/object-shorthand": "error", "eslint/operator-assignment": "error",
    "eslint/prefer-exponentiation-operator": "error", "eslint/prefer-numeric-literals": "error",
    "eslint/prefer-object-has-own": "error", "eslint/prefer-object-spread": "error",
    "eslint/prefer-promise-reject-errors": "error", "eslint/prefer-regex-literals": "error",
    "eslint/prefer-rest-params": "error", "eslint/prefer-spread": "error", "eslint/radix": "error",
    "eslint/sort-vars": "error", "eslint/symbol-description": "error", "eslint/unicode-bom": "error",
    "eslint/vars-on-top": "error", "eslint/yoda": "error",

    // Module boundaries, API documentation and Node.js.
    "import/export": "error", "import/extensions": "error", "import/named": "error",
    "import/newline-after-import": "error", "import/no-amd": "error",
    "import/no-anonymous-default-export": "error", "import/no-commonjs": "error",
    "import/no-dynamic-require": "error", "import/no-mutable-exports": "error",
    "import/no-named-default": "error", "import/no-namespace": "error",
    "import/no-webpack-loader-syntax": "error", "jsdoc/check-access": "error", "jsdoc/empty-tags": "error",
    "jsdoc/no-blank-blocks": "error", "jsdoc/require-param-description": "error",
    "jsdoc/require-param-name": "error", "jsdoc/require-param-type": "error",
    "jsdoc/require-returns-description": "error", "jsdoc/require-returns-type": "error",
    "jsdoc/require-throws-description": "error", "jsdoc/require-throws-type": "error",
    "jsdoc/require-yields-description": "error", "jsdoc/require-yields-type": "error",
    "node/exports-style": "error", "node/global-require": "error", "node/handle-callback-err": "error",
    "node/no-mixed-requires": "error", "node/no-new-require": "error", "node/no-path-concat": "error",
    "oxc/bad-bitwise-operator": "error", "oxc/branches-sharing-code": "error", "oxc/no-barrel-file": "error",
    "oxc/no-const-enum": "error", "promise/no-nesting": "error",
    "promise/no-return-in-finally": "error", "promise/no-return-wrap": "error", "promise/spec-only": "error",

    // React components, hooks and accessible markup.
    "jsx-a11y/anchor-ambiguous-text": "error", "react/checked-requires-onchange-or-readonly": "error",
    "react/display-name": "error", "react/forbid-dom-props": "error", "react/forbid-elements": "error",
    "react/invariant": "error", "react/jsx-boolean-value": "error", "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error", "react/jsx-no-target-blank": "error", "react/jsx-pascal-case": "error",
    "react/no-clone-element": "error", "react/no-danger": "error", "react/no-react-children": "error",
    "react/no-redundant-should-component-update": "error", "react/no-set-state": "error",
    "react/no-unescaped-entities": "error", "react/no-unknown-property": "error",
    "react/prefer-es6-class": "error", "react/prefer-function-component": "error",
    "react/require-render-return": "error", "react/rules-of-hooks": "error", "react/self-closing-comp": "error",
    "react/state-in-constructor": "error", "react/syntax": "error", "react/unsupported-syntax": "error",

    // TypeScript types and type-aware comparisons.
    "typescript/adjacent-overload-signatures": "error", "typescript/ban-ts-comment": "error",
    "typescript/ban-tslint-comment": "error", "typescript/ban-types": "error",
    "typescript/class-literal-property-style": "error", "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-assertions": "error", "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error", "typescript/dot-notation": "error",
    // Diagnostic messages stringify external values of unknown type.
    "typescript/no-deprecated": "error",
    "typescript/no-dynamic-delete": "error", "typescript/no-empty-interface": "error",
    "typescript/no-empty-object-type": "error", "typescript/no-import-type-side-effects": "error",
    "typescript/no-inferrable-types": "error", "typescript/no-mixed-enums": "error",
    "typescript/no-namespace": "error", "typescript/no-require-imports": "error",
    "typescript/no-restricted-types": "error", "typescript/no-unnecessary-qualifier": "error",
    "typescript/no-unsafe-function-type": "error", "typescript/no-var-requires": "error",
    "typescript/prefer-enum-initializers": "error", "typescript/prefer-find": "error",
    "typescript/prefer-function-type": "error", "typescript/prefer-includes": "error",
    "typescript/prefer-literal-enum-member": "error", "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-return-this-type": "error", "typescript/prefer-ts-expect-error": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/unified-signatures": "error",

    // JavaScript API usage and control flow.
    "unicorn/consistent-date-clone": "error", "unicorn/consistent-empty-array-spread": "error",
    "unicorn/consistent-template-literal-escape": "error", "unicorn/empty-brace-spaces": "error",
    "unicorn/error-message": "error", "unicorn/explicit-timer-delay": "error",
    "unicorn/no-abusive-eslint-disable": "error", "unicorn/no-anonymous-default-export": "error",
    "unicorn/no-array-method-this-argument": "error",
    "unicorn/no-console-spaces": "error", "unicorn/no-document-cookie": "error",
    "unicorn/no-hex-escape": "error", "unicorn/no-immediate-mutation": "error",
    "unicorn/no-instanceof-array": "error", "unicorn/no-length-as-slice-end": "error",
    "unicorn/no-magic-array-flat-depth": "error", "unicorn/no-negation-in-equality-check": "error",
    "unicorn/no-new-buffer": "error", "unicorn/no-static-only-class": "error",
    "unicorn/no-this-assignment": "error", "unicorn/no-typeof-undefined": "error",
    "unicorn/no-unnecessary-array-flat-depth": "error", "unicorn/no-unnecessary-array-splice-count": "error",
    "unicorn/no-unnecessary-slice-end": "error", "unicorn/no-useless-collection-argument": "error",
    "unicorn/no-useless-iterator-to-array": "error", "unicorn/no-useless-switch-case": "error",

    "unicorn/prefer-array-flat": "error", "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-array-some": "error", "unicorn/prefer-bigint-literals": "error",
    "unicorn/prefer-blob-reading-methods": "error", "unicorn/prefer-class-fields": "error",
    "unicorn/prefer-classlist-toggle": "error", "unicorn/prefer-date-now": "error",
    "unicorn/prefer-default-parameters": "error", "unicorn/prefer-dom-node-append": "error",
    "unicorn/prefer-dom-node-remove": "error", "unicorn/prefer-dom-node-text-content": "error",
    "unicorn/prefer-event-target": "error", "unicorn/prefer-import-meta-properties": "error",
    "unicorn/prefer-includes": "error", "unicorn/prefer-keyboard-event-key": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error", "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-math-trunc": "error", "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/prefer-modern-math-apis": "error", "unicorn/prefer-module": "error",
    "unicorn/prefer-native-coercion-functions": "error", "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-node-protocol": "error", "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-optional-catch-binding": "error", "unicorn/prefer-prototype-methods": "error",
    "unicorn/prefer-reflect-apply": "error", "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-string-trim-start-end": "error", "unicorn/require-module-attributes": "error",
    "unicorn/require-number-to-fixed-digits-argument": "error",
    "unicorn/switch-case-break-position": "error",
    "unicorn/text-encoding-identifier-case": "error", "unicorn/throw-new-error": "error",

    // Automatic JSX runtime does not import React into scope.
    "react/react-in-jsx-scope": "off",
    // Sequential I/O, bounded-memory chunks, and shared stop flags await or poll inside loops.
    "eslint/no-await-in-loop": "off",
    "eslint/no-unmodified-loop-condition": "off",
    // Local callbacks and helpers reuse domain names and stay next to their callers.
    "eslint/no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    // Owned arrays use in-place sort/reverse, fixed-length allocation, map spreads, and small allow-lists.
    "oxc/no-map-spread": "off",
    "typescript/require-array-sort-compare": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-new-array": "off",
    // Some filters narrow the result type before taking the first item.
    "unicorn/prefer-array-find": "off",
    "unicorn/prefer-set-has": "off",
    // Boundary decoders, DOM queries, and callbacks rely on TypeScript return checks and narrowing casts.
    "typescript/consistent-return": "off",
    // Diagnostic messages stringify external values of unknown type.
    "typescript/no-base-to-string": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/unbound-method": "off",
    // Web Workers use Worker.postMessage (no targetOrigin) and on* handlers; side-effect chains omit returns.
    "promise/always-return": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.*"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/valid-expect": ["error", { "maxArgs": 2 }],
        "vitest/consistent-each-for": "error", "vitest/consistent-test-filename": "error",
        "vitest/consistent-vitest-vi": "error",
        "vitest/hoisted-apis-on-top": "error", "vitest/max-nested-describe": "error",
        "vitest/no-alias-methods": "error",
        "vitest/no-conditional-tests": "error", "vitest/no-disabled-tests": "error",
        "vitest/no-duplicate-hooks": "error", "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error", "vitest/no-interpolation-in-snapshots": "error",
        "vitest/no-large-snapshots": "error", "vitest/no-mocks-import": "error",
        "vitest/no-restricted-matchers": "error", "vitest/no-restricted-vi-methods": "error",
        "vitest/no-standalone-expect": "error", "vitest/no-test-prefixes": "error",
        "vitest/no-test-return-statement": "error", "vitest/no-unneeded-async-expect-function": "error",
        "vitest/padding-around-after-all-blocks": "error", "vitest/prefer-called-exactly-once-with": "error",
        "vitest/prefer-equality-matcher": "error", "vitest/prefer-hooks-in-order": "error",
        "vitest/prefer-importing-vitest-globals": "error", "vitest/prefer-mock-promise-shorthand": "error",
        "vitest/prefer-mock-return-shorthand": "error", "vitest/prefer-snapshot-hint": "error",
        "vitest/prefer-spy-on": "error", "vitest/prefer-strict-boolean-matchers": "error",
        "vitest/prefer-to-be": "error", "vitest/prefer-to-be-object": "error",
        "vitest/prefer-to-contain": "error", "vitest/prefer-to-have-been-called-times": "error",
        "vitest/prefer-todo": "error", "vitest/require-awaited-expect-poll": "error",
        "vitest/require-local-test-context-for-concurrent-snapshots": "error",
        // Test doubles can infer the signature from their implementation.

        "vitest/valid-describe-callback": "error", "vitest/valid-expect-in-promise": "error",
        "vitest/valid-title": "error", "vitest/warn-todo": "error",
        // Node's test() returns a promise; tests use shared helpers, guarded audit checks, stub classes, and typed-array spreads.
        "typescript/no-floating-promises": "off",
        "vitest/expect-expect": "off",
        "vitest/no-conditional-expect": "off",
        // Test doubles can infer the signature from their implementation.
        "vitest/require-mock-type-parameters": "off",
        // Rejection alone is the contract in validation tests.
        "vitest/require-to-throw-message": "off"
      }
    },
    {
      "files": ["app/src/**"],
      "rules": {
        // Stylesheet imports, fire-and-forget UI/worker triggers, and formatted load errors.
        "eslint/preserve-caught-error": "off",
        "import/no-unassigned-import": "off",
        "promise/no-callback-in-promise": "off",
        "typescript/no-floating-promises": "off",
        // These updates copy enumerable data fields into plain view records.
        "typescript/no-misused-spread": "off",
        // Views coordinate browser and WebGPU lifecycles via effects and refs without React Compiler.
        "react-hooks/exhaustive-deps": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/no-array-index-key": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/no-unstable-nested-components": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        // Delegated card/canvas pointer handlers, roving focus, autofocused editors, and Safari role="list" lists.
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-redundant-roles": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    // Stores an async rejection expectation before triggering the event and awaits it afterward.
    {
      "files": [
        "app/src/features/gallery/turnstile.test.ts",
        "app/src/reader/client.test.ts",
        "gallery/test/publish-library-folder.test.ts"
      ],
      "plugins": ["vitest"],
      "rules": { "vitest/valid-expect": "off" }
    },
    // The reference equations retain zero coefficients.
    { "files": ["app/src/features/how/automaton-math.test.ts", "app/src/replay/figure-reference.test.ts"], "rules": { "oxc/erasing-op": "off" } },
    // The worker test double has only a constructor.
    { "files": ["app/src/features/look/region-graph.test.ts"], "rules": { "typescript/no-extraneous-class": "off" } },
    // The test compares copied library values.
    { "files": ["app/src/library/library.test.ts"], "rules": { "unicorn/no-useless-spread": "off" } },
    // The view passes its named initialization function to useMemo.
    { "files": ["app/src/ui/code-space/code-space-3d.tsx"], "rules": { "react/use-memo": "off" } },
    // The upload provider publishes the current selection and its handlers together.
    { "files": ["app/src/app/uploaded-picture.tsx"], "rules": { "react/jsx-no-constructed-context-values": "off" } },
    // The toolbar delegates focus to its buttons.
    { "files": ["app/src/features/automata/tries-strip.tsx"], "rules": { "jsx-a11y/interactive-supports-focus": "off" } },
    // The interactive canvas accepts keyboard selection.
    { "files": ["app/src/ui/code-space/code-plane.tsx"], "rules": { "jsx-a11y/no-noninteractive-tabindex": "off" } },
    // Strips ASCII control characters from exported clip filenames.
    { "files": ["app/src/features/editor/video/clip.ts"], "rules": { "eslint/no-control-regex": "off" } },
    // Typed querySelector wrapper forwards T to document.querySelector<T>.
    { "files": ["app/src/replay/replay-page.ts"], "rules": { "typescript/no-unnecessary-type-parameters": "off" } },
    // IndexedDB transaction helper takes an explicit void completion result type.
    { "files": ["app/src/storage/creations.ts"], "rules": { "typescript/no-invalid-void-type": "off" } },
    // Dispatches run and pause commands before entering the remaining command switch.
    { "files": ["app/src/synthesis/engine.worker.ts"], "rules": { "typescript/switch-exhaustiveness-check": "off" } },
    // Vite dev server middleware supports async handlers.
    { "files": ["app/vite.config.ts"], "rules": { "oxc/no-async-endpoint-handlers": "off" } },
    // Benchmark profile filename interpolates parsed CLI option fields.
    { "files": ["engine/benchmarks/set-methods-in-chrome.ts"], "rules": { "typescript/restrict-template-expressions": "off" } },
    // Keeps the escaped slash consistent inside the credential character class.
    { "files": ["gallery/src/credential-patterns.ts"], "rules": { "eslint/no-useless-escape": ["error", { "allowRegexCharacters": ["/"] }] } }
  ]
}
