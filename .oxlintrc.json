{
  "$schema": "./ci/node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "jsdoc", "node", "promise"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "options": { "typeAware": true },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.wrangler/**",
    "engine/pkg*/**",
    "engine/target/**",
    "engine/vendor/**",
    "engine/dist-harness/**",
    "local/**"
  ],
  "env": { "browser": true, "node": true, "worker": true, "es2024": true },
  "rules": {
    // Explicit rules and options enforced alongside correctness, suspicious, and perf.
    "eslint/array-callback-return": "error",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["NumberInput"] }],
    "react/jsx-filename-extension": ["error", { "extensions": [".jsx", ".tsx"] }],
    "typescript/no-invalid-void-type": ["error", { "allowInGenericTypeArguments": true }],
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],

    // Automatic JSX runtime does not import React into scope.
    "react/react-in-jsx-scope": "off",
    // Sequential I/O, bounded-memory chunks, and shared stop flags await or poll inside loops.
    "eslint/no-await-in-loop": "off",
    "eslint/no-unmodified-loop-condition": "off",
    // Local callbacks and helpers reuse domain names and stay next to their callers.
    "eslint/no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    // Owned arrays use in-place sort/reverse, fixed-length allocation, map spreads, and small allow-lists.
    "oxc/no-map-spread": "off",
    "typescript/require-array-sort-compare": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/prefer-set-has": "off",
    // Boundary decoders, DOM queries, and callbacks rely on TypeScript return checks and narrowing casts.
    "typescript/consistent-return": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/unbound-method": "off",
    // Web Workers use Worker.postMessage (no targetOrigin) and on* handlers; side-effect chains omit returns.
    "promise/always-return": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.*"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/valid-expect": ["error", { "maxArgs": 2 }],
        // Node's test() returns a promise; tests use shared helpers, guarded audit checks, stub classes, and typed-array spreads.
        "oxc/erasing-op": "off",
        "typescript/no-extraneous-class": "off",
        "typescript/no-floating-promises": "off",
        "unicorn/no-useless-spread": "off",
        "vitest/expect-expect": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off"
      }
    },
    {
      "files": ["app/src/**"],
      "rules": {
        // Stylesheet imports, fire-and-forget UI/worker triggers, and formatted load errors.
        "eslint/preserve-caught-error": "off",
        "import/no-unassigned-import": "off",
        "promise/no-callback-in-promise": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-spread": "off",
        // Views coordinate browser and WebGPU lifecycles via effects and refs without React Compiler.
        "react-hooks/exhaustive-deps": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/immutability": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/memo-dependencies": "off",
        "react/no-array-index-key": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/no-unstable-nested-components": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/use-memo": "off",
        // Delegated card/canvas pointer handlers, roving focus, autofocused editors, and Safari role="list" lists.
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/interactive-supports-focus": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/no-redundant-roles": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    // Stores an async rejection expectation before triggering the event and awaits it afterward.
    {
      "files": [
        "app/src/features/gallery/turnstile.test.ts",
        "app/src/reader/client.test.ts",
        "gallery/test/publish-library-folder.test.ts"
      ],
      "plugins": ["vitest"],
      "rules": { "vitest/valid-expect": "off" }
    },
    // Strips ASCII control characters from exported clip filenames.
    { "files": ["app/src/features/editor/video/clip.ts"], "rules": { "eslint/no-control-regex": "off" } },
    // Typed querySelector wrapper forwards T to document.querySelector<T>.
    { "files": ["app/src/replay/replay-page.ts"], "rules": { "typescript/no-unnecessary-type-parameters": "off" } },
    // IndexedDB transaction helper takes an explicit void completion result type.
    { "files": ["app/src/storage/creations.ts"], "rules": { "typescript/no-invalid-void-type": "off" } },
    // Dispatches run and pause commands before entering the remaining command switch.
    { "files": ["app/src/synthesis/engine.worker.ts"], "rules": { "typescript/switch-exhaustiveness-check": "off" } },
    // Vite dev server middleware supports async handlers.
    { "files": ["app/vite.config.ts"], "rules": { "oxc/no-async-endpoint-handlers": "off" } },
    // Benchmark profile filename interpolates parsed CLI option fields.
    { "files": ["engine/benchmarks/set-methods-in-chrome.ts"], "rules": { "typescript/restrict-template-expressions": "off" } },
    // Keeps the escaped slash consistent inside the credential character class.
    { "files": ["gallery/src/credential-patterns.ts"], "rules": { "eslint/no-useless-escape": ["error", { "allowRegexCharacters": ["/"] }] } }
  ]
}
