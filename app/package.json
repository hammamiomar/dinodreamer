{
  "name": "dinodreamer-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "develop": "vite --host 127.0.0.1",
    "develop:fixtures": "vite --host 127.0.0.1 --mode fixtures",
    "develop:remote": "vite --host 127.0.0.1 --mode remote",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dinodreamer-engine": "link:../engine/pkg",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "^0.1.74",
    "fake-indexeddb": "6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
