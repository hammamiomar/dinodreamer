# `pnpm develop:remote`: the public bucket from app/.env, proxied by the dev server.
ASSET_BASE_URL=/remote-library
ASSET_RELEASE=pass-003
# The dev server runs on localhost, which a real Turnstile key does not admit.
# Cloudflare's test key always passes and gives the token XXXX.DUMMY.TOKEN.XXXX.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
